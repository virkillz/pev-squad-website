<Layouts.app flash={@flash} current_scope={@current_scope} active={:home}>
  <!-- HERO ================================================================== -->
  <section class="hero">
    <div class="hero-panel hero-orange">
      <div class="meta-row">
        <div class="meta-text">EST. 2023</div>
        <div class="meta-text">{@date_stamp}</div>
        <div class="meta-text meta-right">LOC: 6.2088° S<br />JAKARTA, ID</div>
      </div>

      <div class="hero-lockup">
        <span class="tag-scribble hero-scribble">we take it</span>
        <h1 class="display-huge lines-2">PERS<br />ONAL</h1>
      </div>

      <p class="hero-motto">
        {gettext(
          "A COLLECTIVE OF PEV RIDERS CHASING SPEED, ADVENTURE AND FREEDOM — MOSTLY BECAUSE IT'S FUN."
        )}
      </p>

      <p class="hero-sub">
        {gettext(
          "Along the way we picked up a growing list of brands, media, and personalities who ride with us. Indonesia's most active EUC community."
        )}
      </p>

      <div class="hero-actions">
        <.link navigate={~p"/community"} class="btn btn-solid">{gettext("Join the Squad")}</.link>
        <a href="#collaborate" class="btn btn-outline">{gettext("Collaborate With Us")}</a>
      </div>
    </div>

    <div class="hero-panel hero-white">
      <%= case @latest_posts do %>
        <% [feature | rest] -> %>
          <div class="meta-row">
            <span class="eyebrow">{gettext("Latest // News & Articles")}</span>
            <.link navigate={~p"/news"} class="meta-text">{gettext("All news")} →</.link>
          </div>

          <.link
            class="latest-feature"
            navigate={PostComponents.post_path(feature.post)}
            style="margin-top:1.25rem;"
            id="latest-post"
            lang={feature.t.locale}
          >
            <img :if={feature.post.cover_path} src={feature.post.cover_path} alt="" />
            <div class="latest-copy">
              <h2 class="latest-title">{feature.t.title}</h2>
              <p class="latest-desc">{PevSquad.Posts.excerpt(feature.t)}</p>
            </div>
          </.link>

          <.link
            :for={item <- rest}
            class={["latest-row", !item.post.cover_path && "no-image"]}
            navigate={PostComponents.post_path(item.post)}
            lang={item.t.locale}
          >
            <img :if={item.post.cover_path} src={item.post.cover_path} alt="" />
            <div>
              <h3 class="latest-title">{item.t.title}</h3>
              <p class="latest-desc">{PostComponents.post_meta(item.post, item.t)}</p>
            </div>
          </.link>
        <% [] -> %>
          <div class="meta-row">
            <span class="eyebrow">{gettext("Latest // Urban Playground")}</span>
            <span class="meta-text">{gettext("New drop")}</span>
          </div>

          <.link class="latest-feature" navigate={~p"/gallery"} style="margin-top:1.25rem;">
            <img
              src="/images/pev_playground_shaz_1.png"
              alt={gettext("Urban Playground plate — Shaz riding an EUC on a parking level")}
            />
            <div class="latest-copy">
              <h2 class="latest-title">{gettext("Shaz is Back!")}</h2>
              <p class="latest-desc">
                {gettext("After maternity hiatus, our little speed demon is back. With revenge.")}
              </p>
            </div>
          </.link>

          <.link class="latest-row" navigate={~p"/gallery"}>
            <img
              src="/images/pev_playground_girls_1.png"
              alt={gettext("Urban Playground plate — the PEV Girls Squad with their EUCs")}
            />
            <div>
              <h3 class="latest-title">PEV Girls Squad</h3>
              <p class="latest-desc">{gettext("Introducing EUC female rider squad.")}</p>
            </div>
          </.link>
      <% end %>

      <div style="margin-top:2rem;">
        <span class="eyebrow">{gettext("Next up")}</span>
        <%= if @next_event do %>
          <h2 class="card-title" style="margin-top:0.75rem; font-size:1.7rem;">
            {@next_event.title}
          </h2>
          <p class="card-meta">{EventComponents.next_up_meta(@next_event)}</p>
          <div class="hero-actions" style="margin-top:1.25rem;">
            <.link navigate={~p"/events/#{@next_event.slug}"} class="btn btn-solid">RSVP</.link>
            <.link navigate={~p"/events"} class="btn btn-outline">{gettext("All Events")}</.link>
          </div>
        <% else %>
          <h2 class="card-title" style="margin-top:0.75rem; font-size:1.7rem;">
            {gettext("Next ride TBA")}
          </h2>
          <p class="card-meta">{gettext("WATCH THE WHATSAPP GROUP")}</p>
          <div class="hero-actions" style="margin-top:1.25rem;">
            <.link navigate={~p"/gallery"} class="btn btn-solid">
              {gettext("See the Gallery")}
            </.link>
            <.link navigate={~p"/events"} class="btn btn-outline">{gettext("All Events")}</.link>
          </div>
        <% end %>
      </div>
    </div>
  </section>
  
<!-- FEATURED PHOTOS — staff pick them in the album editor. Until there are
     any, the squad photo fills the slot (full bleed, carries its own type). -->
  <PevSquadWeb.GalleryComponents.featured_carousel
    :if={@featured_photos != []}
    photos={@featured_photos}
  />
  <div :if={@featured_photos == []} class="bleed">
    <img
      src="/images/community.png"
      alt={gettext("PEV Squad members and their EUCs and scooters gathered in a parking garage")}
    />
  </div>
  
<!-- RIDER OF THE DAY — picked automatically each day (Riders.rider_of_the_day/1). -->
  <PevSquadWeb.RiderComponents.rider_spotlight
    :if={@rider_of_the_day}
    rider={@rider_of_the_day}
    date={@today}
    share_url={url(~p"/community/#{@rider_of_the_day.slug}")}
  />
  
<!-- BY THE NUMBERS ======================================================== -->
  <section class="band band-tight band-black">
    <div class="section-head" style="margin-bottom:1.75rem;">
      <div>
        <span class="eyebrow">{gettext("By the numbers")}</span>
      </div>
      <a href="#" class="btn btn-outline">{gettext("Join WhatsApp Group")}</a>
    </div>
    <div class="statbar">
      <div class="stat">
        <div class="stat-n">184</div>
        <div class="stat-l">{gettext("Active Members")}</div>
      </div>
      <div class="stat">
        <div class="stat-n">9</div>
        <div class="stat-l">{gettext("Cities")}</div>
      </div>
      <div class="stat">
        <div class="stat-n">62,000+</div>
        <div class="stat-l">{gettext("KM Logged")}</div>
      </div>
      <div class="stat">
        <div class="stat-n">37</div>
        <div class="stat-l">{gettext("Meetups Held")}</div>
      </div>
    </div>
  </section>
  
<!-- MARQUEE =============================================================== -->
  <div class="marquee">
    <div class="marquee-inner">
      <span class="marquee-text">{gettext("SPEED · ADVENTURE · FREEDOM")} //</span>
      <span class="marquee-text"><em>62,000 KM</em> {gettext("LOGGED")} //</span>
      <span class="marquee-text">{gettext("SPEED · ADVENTURE · FREEDOM")} //</span>
      <span class="marquee-text"><em>62,000 KM</em> {gettext("LOGGED")} //</span>
    </div>
  </div>
  
<!-- THREE PILLARS ========================================================= -->
  <section class="band band-white">
    <div class="section-head">
      <div>
        <span class="eyebrow">{gettext("What we're about")}</span>
        <h2 class="section-title">{gettext("Speed. Adventure.")}<br />{gettext("Freedom.")}</h2>
      </div>
      <.link navigate={~p"/about"} class="btn btn-outline">{gettext("About Us")}</.link>
    </div>
    <div class="grid grid-3 grid-rule">
      <div class="pillar">
        <div class="pillar-num">01 / {gettext("RACE")}</div>
        <h3>{gettext("Speed")}</h3>
        <p>
          {gettext(
            "Races and competitions — drag runs, cannonball races, anything with a start line. Performance EUCs, tuned scooters and boards, pushed to find out what they actually do."
          )}
        </p>
      </div>
      <div class="pillar">
        <div class="pillar-num">02 / {gettext("TOUR")}</div>
        <h3>{gettext("Adventure")}</h3>
        <p>
          {gettext(
            "Group rides, weekend getaways and multi-day tours. Night loops through the city, trails in Bogor, the spine of Java. Range anxiety is just part of the route plan."
          )}
        </p>
      </div>
      <div class="pillar">
        <div class="pillar-num">03 / {gettext("COMMUTE")}</div>
        <h3>{gettext("Freedom")}</h3>
        <p>
          {gettext(
            "A PEV is a real way to get to work. Ride to the station, take it on public transport, ride the last mile — no traffic jams, no parking, your own schedule."
          )}
        </p>
      </div>
    </div>
  </section>
  
<!-- EXPLORE INDEX ========================================================= -->
  <section class="band band-black">
    <div class="section-head">
      <div>
        <span class="eyebrow">{gettext("Where to go")}</span>
        <h2 class="section-title">{gettext("The Index")}</h2>
        <p class="section-lede">{gettext("Everything the squad runs, in one list.")}</p>
      </div>
    </div>
    <div class="index-list">
      <.link class="index-row" navigate={~p"/community"}>
        <div class="index-num">01 / 06</div>
        <div class="index-title">{gettext("Community")}</div>
        <div class="index-desc">
          {gettext(
            "Riders from every corner of the city, one shared obsession with going fast on three wheels or less."
          )}
        </div>
        <div class="index-meta">{gettext("184 MEMBERS · 9 CITIES")}</div>
      </.link>
      <.link class="index-row" navigate={~p"/gallery"}>
        <div class="index-num">02 / 06</div>
        <div class="index-title">{gettext("Gallery")}</div>
        <div class="index-desc">
          {gettext(
            "Urban Playground — the squad's plate series of riders, machines, and car parks."
          )}
        </div>
        <div class="index-meta">{gettext("2 NEW DROPS")}</div>
      </.link>
      <.link class="index-row" navigate={~p"/reviews"}>
        <div class="index-num">03 / 06</div>
        <div class="index-title">{gettext("Reviews")}</div>
        <div class="index-desc">
          {gettext(
            "Unfiltered, ridden-not-sponsored breakdowns of EUCs, scooters, and boards — rated by riders who own them."
          )}
        </div>
        <div class="index-meta">EUC / SCOOTER / ESK8</div>
      </.link>
      <.link class="index-row" navigate={~p"/for-sale"}>
        <div class="index-num">04 / 06</div>
        <div class="index-title">{gettext("For Sale")}</div>
        <div class="index-desc">
          {gettext(
            "Buy and sell gear inside the squad — new and second-hand units, straight from rider to rider."
          )}
        </div>
        <div class="index-meta">{gettext("7 LIVE LISTINGS")}</div>
      </.link>
      <.link class="index-row" navigate={~p"/events"}>
        <div class="index-num">05 / 06</div>
        <div class="index-title">{gettext("Events")}</div>
        <div class="index-desc">
          {gettext(
            "Group rides, meetups, and demo days — what we've done and what's coming up next."
          )}
        </div>
        <div class="index-meta">{gettext("%{count} UPCOMING", count: @upcoming_count)}</div>
      </.link>
      <.link class="index-row" navigate={~p"/news"}>
        <div class="index-num">06 / 06</div>
        <div class="index-title">{gettext("News")}</div>
        <div class="index-desc">
          {gettext(
            "Ride recaps, announcements and PEV news, plus guides on safety, maintenance and gear."
          )}
        </div>
        <div class="index-meta">{gettext("NEWS · ARTICLES")}</div>
      </.link>
    </div>
  </section>
  
<!-- COLLABORATE =========================================================== -->
  <section id="collaborate" class="band band-orange">
    <div class="section-head">
      <div>
        <span class="eyebrow">{gettext("How to collaborate")}</span>
        <h2 class="section-title">{gettext("If It's Fun,")}<br />{gettext("We're In.")}</h2>
        <p class="section-lede">
          {gettext(
            "Most of us have day jobs — this is what we do for fun. So the bar for working with PEV Squad isn't a media kit, it's one question: will it be fun? Get that right and we're already halfway there."
          )}
        </p>
      </div>
      <a href="#" class="btn btn-solid" style="background:var(--black); color:var(--orange);">
        {gettext("Reach Out on WhatsApp")}
      </a>
    </div>
    <div class="grid grid-3 grid-rule">
      <div class="pillar">
        <div class="pillar-num">01 / {gettext("SHOW UP")}</div>
        <h3>{gettext("Invite Us to Your Event")}</h3>
        <p>
          {gettext(
            "A pack of one-wheeled speed junkies showing up to your meetup, race, or brand activation? Consider us there."
          )}
        </p>
      </div>
      <div class="pillar">
        <div class="pillar-num">02 / {gettext("ON CAMERA")}</div>
        <h3>{gettext("Use Us for Content")}</h3>
        <p>
          {gettext(
            "Need riders, footage, or a squad on camera? We're in — no fee required, just make it fun."
          )}
        </p>
      </div>
      <div class="pillar">
        <div class="pillar-num">03 / {gettext("HANDS ON")}</div>
        <h3>{gettext("Ask Us to Help Run It")}</h3>
        <p>
          {gettext(
            "We once marshalled a running event purely because we thought it'd be a laugh. Ask and find out."
          )}
        </p>
      </div>
    </div>
  </section>
</Layouts.app>
