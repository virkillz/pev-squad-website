<Layouts.app flash={@flash} current_scope={@current_scope} active={@active}>
  <section class="page-header">
    <div class="meta-row">
      <span class="eyebrow">{@num} / {gettext("Under construction")}</span>
      <span class="tag-scribble">{gettext("soon")}</span>
    </div>
    <h1 class="page-title" style="font-size:clamp(3.5rem, 12vw, 11rem);">{@title}</h1>
    <p class="page-intro">
      {gettext(
        "This section is still being moved over from the prototype. Events and RSVPs are live already."
      )}
    </p>
  </section>
  <section class="band band-black">
    <div class="hero-actions">
      <.link navigate={~p"/events"} class="btn btn-solid">{gettext("See Events")}</.link>
      <.link navigate={~p"/"} class="btn btn-outline">{gettext("Back Home")}</.link>
    </div>
  </section>
</Layouts.app>
