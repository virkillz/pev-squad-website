{
  "expo": {
    "name": "PEV Squad",
    "slug": "pev-squad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pevsquad",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "org.pevsquad.app",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:pev-squad.org"
      ],
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {}
    },
    "android": {
      "package": "org.pevsquad.app",
      "adaptiveIcon": {
        "backgroundColor": "#FF4800",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF4800",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "PEV Squad uses your photos to set your rider profile picture. / PEV Squad memakai fotomu untuk foto profil rider.",
          "cameraPermission": "PEV Squad uses the camera to take your rider profile picture. / PEV Squad memakai kamera untuk foto profil rider.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4e252e86-1524-4908-a818-2c74659aeb9e"
      }
    },
    "owner": "virkill"
  }
}
